# 本地开发默认使用 SQLite，生产环境建议改为 MySQL。
DATABASE_URL=sqlite:///data/rag_assistant.sqlite3

# MySQL 示例：
# DATABASE_URL=mysql+pymysql://rag_user:rag_password@127.0.0.1:3306/rag_assistant?charset=utf8mb4

# 向量库与集合名
PARENT_COLLECTION=parent_documents
CHILD_COLLECTION=child_documents

# 本地测试可用 hash；生产环境建议使用 sentence-transformers 加载 bge-large-zh-v1.5。
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSION=768

# 父子切分参数
PARENT_CHUNK_SIZE=1800
PARENT_CHUNK_OVERLAP=180
CHILD_CHUNK_SIZE=420
CHILD_CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=8
COMPRESSION_TOP_K=5
HISTORY_TURNS=6

# 通义千问 OpenAI 兼容接口
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
REQUEST_TIMEOUT=60
